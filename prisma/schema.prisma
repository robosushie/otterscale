generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPER_ADMIN
}

enum TenantRole {
  TENANT_ADMIN
  NET_ADMIN
  AUDITOR
  MEMBER
}

enum PolicySnapshotStatus {
  PENDING
  APPLIED
  SUPERSEDED
  FAILED
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  oidcSub           String?   @unique
  passwordHash      String?
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  platformMemberships PlatformMembership[]
  tenantMemberships   TenantMembership[]
  groupMembers        GroupMember[]
  policySnapshots     PolicySnapshot[]     @relation("PolicyAuthor")
  auditEvents         AuditEvent[]         @relation("AuditActor")
  invitesCreated      UserInvite[]         @relation("InviteCreator")
  invitesRedeemed     UserInvite[]         @relation("InviteRedeemer")
}

model UserInvite {
  id               String     @id @default(cuid())
  organizationId   String
  email            String
  username         String
  codeHash         String
  tenantRole       TenantRole @default(MEMBER)
  createdById      String
  expiresAt        DateTime
  redeemedAt       DateTime?
  redeemedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  redeemedBy   User?        @relation("InviteRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @default("Otterscale")
  slug      String   @unique @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings   OrganizationSettings?
  environments Environment[]
  groups     Group[]
  accessRules AccessRule[]
  policySnapshots PolicySnapshot[]
  auditEvents AuditEvent[]
  apiKeys     ApiKey[]
  userInvites UserInvite[]
}

model OrganizationSettings {
  id                              String   @id @default(cuid())
  organizationId                  String   @unique
  setupComplete                   Boolean  @default(false)
  headscalePublicUrl              String?
  headscaleInternalUrl            String?
  relayMapUrl                     String?
  superAdminsImplicitTenantAdmin  Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlatformMembership {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model TenantMembership {
  id            String     @id @default(cuid())
  userId        String
  role          TenantRole
  environmentId String?
  createdAt     DateTime   @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Environment {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  name           String
  tag            String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups            Group[]
  accessRules       AccessRule[]
  tenantMemberships TenantMembership[]

  @@unique([organizationId, slug])
  @@unique([organizationId, tag])
}

model Group {
  id             String   @id @default(cuid())
  organizationId String
  environmentId  String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment  Environment?  @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  members      GroupMember[]
  accessRules  AccessRule[]

  @@unique([organizationId, name])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String?
  email     String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([groupId, email])
}

model AccessRule {
  id             String   @id @default(cuid())
  organizationId String
  environmentId  String
  groupId        String
  ports          String   @default("*")
  action         String   @default("accept")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment  Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model PolicySnapshot {
  id             String               @id @default(cuid())
  organizationId String
  contentHash    String
  hujson         String               @db.Text
  status         PolicySnapshotStatus @default(PENDING)
  authorId       String?
  appliedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("PolicyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  resourceType   String?
  resourceId     String?
  beforeJson     String?  @db.Text
  afterJson      String?  @db.Text
  ipAddress      String?
  userAgent      String?
  previousHash   String
  eventHash      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String
  scopes         String[]
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
