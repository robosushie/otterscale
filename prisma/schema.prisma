generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPER_ADMIN
}

enum TenantRole {
  ADMIN
  MEMBER
}

enum PolicySnapshotStatus {
  PENDING
  APPLIED
  SUPERSEDED
  FAILED
}

enum AuditCategory {
  SYSTEM
  NETWORK
}

enum PublishedAppStatus {
  PENDING
  ACTIVE
  UNREACHABLE
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  oidcSub           String?   @unique
  passwordHash      String?
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  platformMemberships   PlatformMembership[]
  tenantMemberships     TenantMembership[]
  groupMembers          GroupMember[]
  workspaceMemberships  WorkspaceMembership[]
  policySnapshots       PolicySnapshot[]      @relation("PolicyAuthor")
  auditEvents           AuditEvent[]          @relation("AuditActor")
  invitesCreated        UserInvite[]          @relation("InviteCreator")
  invitesRedeemed       UserInvite[]          @relation("InviteRedeemer")
  machinesCreated       Machine[]             @relation("MachineCreator")
  appsCreated           PublishedApp[]        @relation("AppCreator")
}

model UserInvite {
  id               String     @id @default(cuid())
  organizationId   String
  email            String
  username         String
  codeHash         String
  tenantRole       TenantRole    @default(MEMBER)
  platformRole     PlatformRole?
  createdById      String
  expiresAt        DateTime
  redeemedAt       DateTime?
  redeemedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  redeemedBy   User?                @relation("InviteRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  workspaces   UserInviteWorkspace[]

  @@index([organizationId, email])
}

model UserInviteWorkspace {
  inviteId String
  groupId  String

  invite UserInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  group  Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([inviteId, groupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @default("Otterscale")
  slug      String   @unique @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        OrganizationSettings?
  groups          Group[]
  tags            Tag[]
  machines        Machine[]
  accessRules     AccessRule[]
  policySnapshots PolicySnapshot[]
  auditEvents     AuditEvent[]
  apiKeys         ApiKey[]
  userInvites     UserInvite[]
  publishedApps   PublishedApp[]
}

model OrganizationSettings {
  id                             String   @id @default(cuid())
  organizationId                 String   @unique
  setupComplete                  Boolean  @default(false)
  headscalePublicUrl             String?
  headscaleInternalUrl           String?
  relayMapUrl                    String?
  superAdminsImplicitTenantAdmin Boolean  @default(true)
  appsBaseDomain                 String   @default("apps.localhost")
  defaultAuthKeyExpiryHours      Int      @default(24)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlatformMembership {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model TenantMembership {
  id        String     @id @default(cuid())
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  memberships  WorkspaceMembership[]
  inviteLinks  UserInviteWorkspace[]
  machines     MachineWorkspace[]
  accessRules  AccessRule[]

  @@unique([organizationId, name])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String?
  email     String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([groupId, email])
}

model WorkspaceMembership {
  id        String     @id @default(cuid())
  userId    String
  groupId   String
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  aclTag         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  machines     MachineTag[]
  accessRules  AccessRule[]

  @@unique([organizationId, slug])
  @@unique([organizationId, aclTag])
}

model Machine {
  id              String    @id @default(cuid())
  organizationId  String
  headscaleNodeId String    @unique
  name            String
  hostname        String    @default("")
  ipAddresses     String    @default("[]")
  lastOnline      Boolean   @default(false)
  lastSeenAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("MachineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  workspaces   MachineWorkspace[]
  tags         MachineTag[]
  apps         PublishedApp[]
}

model MachineWorkspace {
  machineId String
  groupId   String

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([machineId, groupId])
}

model MachineTag {
  machineId String
  tagId     String

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([machineId, tagId])
}

model AccessRule {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String
  tagId          String?
  ports          String   @default("*")
  action         String   @default("accept")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tag          Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)
}

model PublishedApp {
  id             String             @id @default(cuid())
  organizationId String
  machineId      String
  port           Int
  subdomain      String
  status         PublishedAppStatus @default(PENDING)
  lastError      String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  machine      Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([organizationId, subdomain])
}

model PolicySnapshot {
  id             String               @id @default(cuid())
  organizationId String
  contentHash    String
  hujson         String
  status         PolicySnapshotStatus @default(PENDING)
  authorId       String?
  appliedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("PolicyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  category       AuditCategory @default(SYSTEM)
  resourceType   String?
  resourceId     String?
  beforeJson     String?
  afterJson      String?
  ipAddress      String?
  userAgent      String?
  previousHash   String
  eventHash      String
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String
  scopes         String    @default("[]")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
