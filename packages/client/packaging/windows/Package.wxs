<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Otterscale"
      Manufacturer="Otterscale"
      Version="0.1.0.0"
      UpgradeCode="7C2E9A14-5B6F-4D8A-9E11-0A4C6F2B8D31"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Otterscale is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <util:CloseApplication
        Id="CloseOtterscale"
        Target="otterscale.exe"
        CloseMessage="yes"
        RebootPrompt="no"
        Timeout="5" />

    <Feature Id="Main" Title="Otterscale" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Otterscale">
        <Component Id="OtterscaleExe" Guid="*">
          <File Id="OtterscaleExe" Source="dist\otterscale.exe" KeyPath="yes" />
        </Component>
        <Component Id="TailscaledExe" Guid="*">
          <File Id="TailscaledExe" Source="dist\tailscaled.exe" KeyPath="yes" />
        </Component>
        <Directory Id="BinFolder" Name="bin">
          <Component Id="OtterscaleCli" Guid="*">
            <File Id="OtterscaleCli" Source="dist\bin\otterscale.exe" KeyPath="yes" />
            <Environment Id="OtterscaleCliPath" Name="PATH" Value="[BinFolder]" Permanent="no" Part="last" Action="set" System="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles">
      <ComponentRef Id="OtterscaleExe" />
      <ComponentRef Id="TailscaledExe" />
      <ComponentRef Id="OtterscaleCli" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="*">
        <Shortcut
            Id="AppShortcut"
            Name="Otterscale"
            Description="Otterscale"
            Target="[INSTALLFOLDER]otterscale.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Otterscale"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <CustomAction
        Id="InstallDaemon"
        FileRef="OtterscaleExe"
        ExeCommand="--install-service"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction
        Id="UninstallDaemon"
        FileRef="OtterscaleExe"
        ExeCommand="--uninstall-service"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="StopWindow"
        Directory="SystemFolder"
        ExeCommand="taskkill.exe /F /IM otterscale.exe"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="LaunchApp"
        FileRef="OtterscaleExe"
        ExeCommand=""
        Execute="immediate"
        Impersonate="yes"
        Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_X64" Before="StopWindow" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="StopWindow" Before="UninstallDaemon" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UninstallDaemon" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="InstallDaemon" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
