<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
      Name="Otterscale"
      Manufacturer="Otterscale"
      Version="0.1.0.0"
      UpgradeCode="3F8C1A20-6D4E-4B7A-91C2-5E0A7B3D8F16"
      IconSourceFile="..\..\cmd\desktop\assets\favicon.ico">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseUrl="https://github.com/robosushie/otterscale"
          LogoFile="..\..\..\..\public\favicon.png"
          Theme="hyperlinkLicense" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="Otterscale" SourceFile="dist\otterscale-installer.msi" />
    </Chain>
  </Bundle>
</Wix>
