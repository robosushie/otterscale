{
	auto_https off
}

:{$CADDY_PORT} {
	handle /healthz {
		respond 200
	}

	@console host {$CONSOLE_HOST:console.localhost}
	handle @console {
		reverse_proxy 127.0.0.1:3000
	}

	@hs204 {
		host {$HS_HOST:hs.localhost}
		path /generate_204
	}
	handle @hs204 {
		respond 204
	}

	@hs host {$HS_HOST:hs.localhost}
	handle @hs {
		reverse_proxy 127.0.0.1:18080 {
			header_up True-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	@apps host *.{$APPS_BASE_DOMAIN:apps.localhost}
	handle @apps {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
