# Otterscale stack — copy to .env next to otterscale-stack.yaml.
# Images: ghcr.io/robosushie/otterscale/{headscale,core,app,edge}
# Write each value with no quote characters: AUTH_URL=https://console.example.com
# pnpm deploy:stack builds locally and does not read OTTERSCALE_IMAGE_TAG.

# OTTERSCALE_IMAGE_PREFIX=ghcr.io/robosushie/otterscale
# OTTERSCALE_IMAGE_TAG=latest

AUTH_URL=https://console.localhost
# AUTH_SECRET must be at least 32 characters.
# AUTH_SECRET=

# Empty creates /data/otterscale.db on the core volume. postgres:// uses Postgres.
# DATABASE_URL=

# Production login-server (hostname or URL). Unset → http://127.0.0.1:8080
# OTTERSCALE_DOMAIN=hs.example.com

# Optional SSO (all three required to enable OIDC buttons)
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_SETUP_TOKEN=

# Optional Caddy site names (defaults work with a hosts file)
# CONSOLE_HOST=console.localhost
# HS_HOST=hs.localhost
# APPS_BASE_DOMAIN=apps.localhost
# HEADSCALE_PUBLIC_URL=https://hs.localhost

# Do not set HEADSCALE_INTERNAL_URL, HEADSCALE_API_KEY, or APPS_EDGE_AUTHKEY.
# Init writes the keys onto the otterscale_secrets volume.
