# Otterscale standalone — copy to .env next to where you run docker compose.
# Image: ghcr.io/robosushie/otterscale/standalone
# Do not set HEADSCALE_INTERNAL_URL here (loopback is set in the Compose file).

# OTTERSCALE_IMAGE_PREFIX=ghcr.io/robosushie/otterscale
# OTTERSCALE_IMAGE_TAG=latest

# Production login-server (hostname or URL). Unset → http://127.0.0.1:8080
# OTTERSCALE_DOMAIN=hs.example.com

AUTH_URL=https://console.localhost
# AUTH_SECRET is generated on first boot when empty.
# AUTH_SECRET=

# Empty uses file:/data/otterscale.db. postgres:// uses Postgres.
# DATABASE_URL=

# Optional SSO (all three required to enable OIDC buttons)
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_SETUP_TOKEN=

# Optional Caddy site names (defaults work with a hosts file)
# CONSOLE_HOST=console.localhost
# HS_HOST=hs.localhost
# APPS_BASE_DOMAIN=apps.localhost
# HEADSCALE_PUBLIC_URL=https://hs.localhost

# Do not set HEADSCALE_API_KEY or APPS_EDGE_AUTHKEY.
# Bootstrap writes them under /data/secrets for this Headscale database.
